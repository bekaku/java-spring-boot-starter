# =====================================================================================================
# api-prod — environment for docker-compose/api-prod/docker-compose.yml
#
#   cp .env.example .env      # then edit .env (it is git-ignored; never commit real secrets)
#
# Every value below overrides the same property in src/main/resources/application.yml (Spring Boot
# relaxed binding: upper-case, dots -> "_", dashes removed — e.g. app.jwt.access-token-ttl-minutes
# becomes APP_JWT_ACCESSTOKENTTLMINUTES). Anything left out keeps the application.yml default.
#
#   * Lines marked [REQUIRED] are checked by docker compose; `up` stops if they are empty.
#   * Wrap values that contain "$" in single quotes ('...'), otherwise compose expands them.
#   * Do not put spaces around "=".
#   * WORKER_ID and the scheduled-job flags are set per container in docker-compose.yml — not here.
# =====================================================================================================


# ----- Docker / host (used by docker-compose.yml only, not read by Spring) ---------------------------
# Image name and tag. `docker compose build` tags it with this name.
API_IMAGE=spring-api:prod

# Existing docker network the containers join (create once: docker network create docker-network).
# Put postgres / rabbitmq on the same network to reach them by container name instead of host.docker.internal.
DOCKER_NETWORK=docker-network

# Host interface and ports the three containers are published on (container port is always 8080).
# Use 127.0.0.1 when the reverse proxy (nginx) runs on the same host, so the API is not reachable directly.
API_BIND=0.0.0.0
API_1_PORT=8081
API_2_PORT=8082
API_3_PORT=8083

# [REQUIRED] Host directories (absolute paths).
#   HOST_DATA_DIR : mounted at /usr/spring-data (app.cdn-directory) and shared by all containers.
#                   It is served PUBLICLY at /cdn/** — never put logs or secrets in it.
#   HOST_LOG_DIR  : mounted at /usr/spring-logs (app.log-directory); one sub-directory per container.
#   Both must be writable by uid 1001 (the container user):  sudo chown -R 1001:1001 <dir>
HOST_DATA_DIR=/mnt/cdn/spring-data
HOST_LOG_DIR=/mnt/cdn/spring-logs

# External config directory mounted read-only at /usr/spring-config. The Dockerfile requires the mount
# (spring.config.additional-location). It may hold an optional application.yml for settings that cannot be
# expressed as env vars (lists such as app.menus / app.allow-mimes). Values in this .env still win over it.
# Default: the (empty) ./spring-config next to docker-compose.yml.
#HOST_CONFIG_DIR=./spring-config

# Per-container resource limits.
API_CPUS_LIMIT=2.0
API_MEMORY_LIMIT=2G
API_CPUS_RESERVATION=1.0
API_MEMORY_RESERVATION=1G

# Healthcheck grace period while the app boots (Flyway migration on api-1 can take a while).
API_HEALTH_START_PERIOD=90s

# JVM flags. The Dockerfile default (-Xms1G -Xmx1G ... G1GC) is used when this is unset. Keep -Xmx below
# API_MEMORY_LIMIT. Quote the value because it contains spaces.
#JAVA_OPTS="-Xms1G -Xmx1G -Xss256k -XX:MaxMetaspaceSize=256m -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp/heapdump.hprof"


# ----- Database: spring.datasource.* (PostgreSQL) ----------------------------------------------------
# application.yml still defaults to MySQL, but only the PostgreSQL driver is in build.gradle, so the URL and
# the driver class must be overridden here. The host is reached from the container:
#   host.docker.internal  -> PostgreSQL running on the Docker host
#   <container-name>      -> PostgreSQL on the same DOCKER_NETWORK
# [REQUIRED] SPRING_DATASOURCE_URL / SPRING_DATASOURCE_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/spring_starter_postgres
SPRING_DATASOURCE_USERNAME=postgres_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD
SPRING_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver

# Connection pool PER CONTAINER (spring.datasource.hikari.*): total = pool size x 3 containers, so keep
# 3 x SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE below PostgreSQL max_connections.
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUMIDLE=5

# Flyway (spring.flyway.enabled). Only api-1 reads this value; api-2 / api-3 are forced to false and start
# after api-1 is healthy, so new code never runs against the old schema. Leave false (application.yml default)
# and switch to true for the release that carries a new db/migration/V*.sql, then back to false.
SPRING_FLYWAY_ENABLED=false


# ----- RabbitMQ: spring.rabbitmq.* -------------------------------------------------------------------
# [REQUIRED] SPRING_RABBITMQ_PASSWORD
SPRING_RABBITMQ_HOST=host.docker.internal
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=local_jobs
SPRING_RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
# Listener tuning (application.yml defaults: 3 / 10 / 10).
#SPRING_RABBITMQ_LISTENER_SIMPLE_CONCURRENCY=3
#SPRING_RABBITMQ_LISTENER_SIMPLE_MAXCONCURRENCY=10
#SPRING_RABBITMQ_LISTENER_SIMPLE_PREFETCH=10


# ----- Mail: spring.mail.* (SMTP over SSL, port 465 — see note) --------------------------------------
# application.yml also pins spring.mail.properties.mail.smtp.socketFactory.port=465 (case-sensitive key, so it
# cannot be set from an env var). For an SMTP server on another port, set it in HOST_CONFIG_DIR/application.yml.
SPRING_MAIL_HOST=smtp.your-mail-server.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=noreply@your-domain.com
SPRING_MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD

# app.mail-config.* (sender address and the minutes a mailed token stays valid).
# The odd spelling is deliberate: the yml key is camelCase "tokenExpire" and is read with @Value, so only
# APP_MAIL_CONFIG_TOKENEXPIRE matches it (APP_MAILCONFIG_TOKENEXPIRE would be ignored).
APP_MAILCONFIG_NOREPLYADDRESS=noreply@your-domain.com
APP_MAIL_CONFIG_TOKENEXPIRE=15

# The mail health check goes DOWN when SMTP is unreachable, which would keep the containers "unhealthy" and
# hold back api-2 / api-3. Uncomment to take the SMTP server out of /actuator/health.
#MANAGEMENT_HEALTH_MAIL_ENABLED=false


# ----- Application URL / CORS / cookies: app.* -------------------------------------------------------
# Public base URL of the API as seen by browsers (scheme + host, no trailing slash) and its port.
# app.cdn-url / app.cdn-port default to these two, so file URLs follow them automatically.
APP_URL=https://api.your-domain.com
APP_PORT=443
APP_DOMAIN=your-domain.com
# Only when files are served from a different host/port than the API:
#APP_CDNURL=https://cdn.your-domain.com
#APP_CDNPORT=443

# Allowed browser origins (app.cors.allowed-origins), comma-separated, no spaces. Setting this REPLACES the
# whole list from application.yml, so keep the hybrid-app origins if you ship Capacitor / Ionic apps.
APP_CORS_ALLOWEDORIGINS=https://your-production-webapp.com,http://localhost,https://localhost,capacitor://localhost,ionic://localhost

# Auth cookies (app.cookie.*). Secure must stay true behind HTTPS.
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=Lax
# Blank = host-only cookies. Set a parent domain (example.com or .example.com, hostname only) only when the
# frontend lives on another subdomain than the API and must see the login cookies. See docs/tasks/001-auth-cookie-domain.md
APP_COOKIE_DOMAIN=


# ----- Secrets: app.jwt.* / app.encrypt-key ----------------------------------------------------------
# [REQUIRED] APP_JWT_SECRET: base64 key for signing JWTs.      generate: openssl rand -base64 64
#   Changing it logs every user out.
APP_JWT_SECRET=CHANGE_ME_BASE64_SECRET
#APP_JWT_ACCESSTOKENTTLMINUTES=15
#APP_JWT_REFRESHTOKENTTLDAYS=7

# [REQUIRED] APP_ENCRYPTKEY: AES key, used as raw characters => exactly 16, 24 or 32 chars.   generate: openssl rand -hex 16
#   Changing it makes data already encrypted with the old key undecryptable.
APP_ENCRYPTKEY=CHANGE_ME_16_24_OR_32_CHARS

# app.queue.key
APP_QUEUE_KEY=CHANGE_ME_QUEUE_KEY

# Initial password given to users created by an admin (app.defaults.userpwd). Do not leave the default 1234.
APP_DEFAULTS_USERPWD=CHANGE_ME_DEFAULT_USER_PASSWORD


# ----- Scheduled jobs: app.cron.* --------------------------------------------------------------------
# Only api-1 reads these two flags; api-2 / api-3 are forced to false so a job runs on one container only.
#   (app.cron.enable in application.yml is not read by any code in this starter, so it is not used here.)
# Deletes temp upload chunks older than 1 day (cron: app.cron.clean-file-expression, default 23:30 daily).
APP_CRON_CLEANOLDTEMPCHUNKS=true
# cleanup of old files (currently commented out in FileManagerServiceImpl).
APP_CRON_CLEANOLDFILE=false


# ----- Optional features (disabled in application.yml; uncomment to turn on) -------------------------
# Face recognition service (app.face-recognition.base-url). "localhost" inside the container is the container
# itself, so point it at the host or at the service on DOCKER_NETWORK.
#AI_FACE_RECOGNITION_SERVICE_URL=http://host.docker.internal:8000
#APP_FACERECOGNITION_MATCHTHRESHOLD=0.32
#APP_FACERECOGNITION_MINDETECTIONSCORE=0.70

# RAG / Spring AI (see skills/backend/AI_RAG.md). Defaults to Ollama on localhost:11434 — inside the container
# that is the container itself, so set the base URL. Model names must exist on that server.
#SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
#SPRING_AI_OLLAMA_CHAT_OPTIONS_MODEL=gemma4:e4b
#SPRING_AI_OLLAMA_EMBEDDING_OPTIONS_MODEL=bge-m3

# Qdrant vector store (QdrantVectorStoreConfig is only created when ..._ENABLED=true; app.rag.qdrant-enabled in
# application.yml is not read by any code). The API key is a secret.
#SPRING_AI_VECTORSTORE_QDRANT_ENABLED=true
#SPRING_AI_VECTORSTORE_QDRANT_HOST=host.docker.internal
#SPRING_AI_VECTORSTORE_QDRANT_PORT=6334
#SPRING_AI_VECTORSTORE_QDRANT_APIKEY=CHANGE_ME_QDRANT_API_KEY
#SPRING_AI_VECTORSTORE_QDRANT_USETLS=false
#APP_RAG_DELETESOURCEAFTERINGEST=true
# Lets the chat model query the database through tools. Treat model SQL as untrusted; use a read-only DB user.
#APP_RAG_DATABASETOOLS_ENABLED=false
